fun emit_stage x =
  case x of
    Stage id name instruction digest policy command =>
      print (id ^ "\t" ^ name ^ "\t" ^ instruction ^ "\t" ^
             digest ^ "\t" ^ policy ^ "\t" ^ command ^ "\n");

fun emit_all xs =
  case xs of
    [] => ()
  | x :: rest => (emit_stage x; emit_all rest);

emit_all stages;
