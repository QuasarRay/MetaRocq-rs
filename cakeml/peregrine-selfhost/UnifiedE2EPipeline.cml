(*
  Unified Peregrine -> MetaRocq E2E pipeline.

  This CakeML program is the canonical orchestration plan.  It binds every
  executable stage to the exact SHA-256 of the corresponding instruction file
  supplied in unified-peregrine-metarocq-e2e-instructions.zip.

  Host process execution is performed by the pinned CakeML/regression-derived
  worker.  The separation is deliberate: process success is observability
  evidence, never a substitute for the HOL4 theorems required by the manual.

  TSV format:
    id <TAB> name <TAB> instruction <TAB> sha256 <TAB> policy <TAB> command
*)

datatype stage = Stage string string string string string string;

val stages =
